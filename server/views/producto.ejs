<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Descubre joyería fina hecha a mano. Anillos de compromiso, collares y pulseras en oro y plata. Diseños únicos para momentos inolvidables. Compra online.">
  <meta property="og:title" content="JOYERIA MARQUEZ | COMPRA ONLINE">
  <meta property="og:description" content="<%= PRODUCTO.titulo %>">
  <meta property="og:image" content="https:<%= PRODUCTO.ogImage %>">
  <meta property="og:url" content="https://an8dres.github.io/joyeriamarquez">
  <meta property="og:type" content="website">
  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta property="twitter:domain" content="an8dres.github.io">
  <meta property="twitter:url" content="https://an8dres.github.io/joyeriamarquez/">
  <meta name="twitter:title" content="JOYERIA MARQUEZ">
  <meta name="twitter:description" content="<%= PRODUCTO.titulo %>">
  <meta name="twitter:image" content="https:<%= PRODUCTO.ogImage %>">
    
  <link rel="stylesheet" href="/src/css/style.css">
  <link rel="stylesheet" href="/src/css/producto.css">
  <link rel="icon" href="/src/iconos/icon.png">
  <!-- <script type="module" defer src="/src/js/main.js"></script> -->
  <title>Joyería Márquez</title>
</head>
<body style="background-color: #fff;">
  <article id="product-page" class="active">
    <section class="product-page--block">
      <header>
        <button id="btn-back" aria-label="go back">
          <svg id="btn-back" area-hidden="true"><use href="#icon-arrowback"></use></svg>
        </button>
        <div>
          <button id="btn-fav" aria-label="add to favorite">
            <svg area-hidden="true"><use href="#icon-favorite"></use></svg>
            <svg area-hidden="true"><use href="#icon-favorite-filled"></use></svg>
          </button>
          <button id="btn-share" aria-label="share product">
            <svg area-hidden="true"><use href="#icon-share"></use></svg>
          </button>
        </div>
      </header>
      <div class="product-page-images">
        <img sizes="max(500px, 60vw)" alt="product image" srcset="<%= PRODUCTO.main_image_id %>">
      </div>
    </section>
    <section class="product-page--block">
      <div class="product-page-info">
        <h2><%= PRODUCTO.titulo %></h2>
        <hr>
        <div class="product-page-info--stock">
          <div class="product-page-type">
            <svg area-hidden="true"><use href="#icon-star-filled"></use></svg>
            <span><%= PRODUCTO.tipo %></span>
          </div>
          <span class="product-page-stock">Stock <%= PRODUCTO.stock %></span>
        </div>
        <div class="product-page-prices">
          <span class="price">$ <%= PRODUCTO.precio %></span>
          <s class="lastprice">$ <%= PRODUCTO.precio_anterior %></s>
        </div>
        <p class="product-page-description"><%= PRODUCTO.info %></p>
      </div>
      <div class="product-page-sizes">
        <label tabindex="0"><input type="radio" name="sizes">S</label>
        <label tabindex="0"><input type="radio" name="sizes">M</label>
        <label tabindex="0"><input type="radio" name="sizes">L</label>
        <label tabindex="0"><input type="radio" name="sizes">XL</label>
      </div>
      <div class="product-page-picker">
        <button id="btn-menos">-</button>
        <input id="input-cantidad" type="number" value="1">
        <button id="btn-mas">+</button>
      </div>
      <aside class="product-page-actions">
        <button id="btn-add">
          Agregar
          <svg area-hidden="true"><use href="#icon-cart-out"></use></svg>
        </button>
        <button id="btn-buy">
          Whatsapp
          <svg area-hidden="true"><use href="#icon-cart-filled"></use></svg>
        </button>
      </aside>
    </section>
  </article>

