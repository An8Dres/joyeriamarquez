  <script>
    window.onpopstate = e => { if (location.pathname === '/') location.reload() }
    const img = document.querySelector('.product-page-images img')
    img.complete ? img.classList.add('visible'): 0
    img.onload = () => img.classList.add('visible')
  </script>
</body>
</html>