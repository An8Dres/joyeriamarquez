<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Descubre joyería fina hecha a mano. Anillos de compromiso, collares y pulseras en oro y plata. Diseños únicos para momentos inolvidables. Compra online.">
  <meta property="og:title" content="JOYERIA MARQUEZ">
  <meta property="og:description" content="<%= data.product.titulo  precio: $ data.product.precio %>">
  <meta property="og:image" content="<%= data.ogImage %>">
  <meta property="og:url" content="https://an8dres.github.io/joyeriamarquez">
  <meta property="og:type" content="website">
  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta property="twitter:domain" content="an8dres.github.io">
  <meta property="twitter:url" content="https://an8dres.github.io/joyeriamarquez/">
  <meta name="twitter:title" content="JOYERIA MARQUEZ">
  <meta name="twitter:description" content="Descubre joyería fina hecha a mano. Anillos de compromiso, collares y pulseras en oro y plata. Diseños únicos para momentos inolvidables. Compra online.">
  <meta name="twitter:image" content="https://an8dres.github.io/joyeriamarquez/iconos/preview.png">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/modal.css">

  <link rel="preload" href="/fonts/Poppins-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/Cinzel-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="modulepreload" href="/js/main.js"></link>
  <link rel="modulepreload" href="/js/features/modal.js"></link>
  <!-- <link rel="modulepreload" href="/js/services/api.js"></link> -->
  
  <link rel="icon" href="/favicon.ico">

  <script type="module" src="/js/main.js"></script>
  <title>Joyería Márquez</title>
</head>

<body>
  <main>
    <section id="product-modal" class="visible">
      <section class="product-modal--block">
        <header>
          <button id="btn-back" aria-label="go back">
            <svg area-hidden="true">
              <use href="#icon-arrowback"></use>
            </svg>
          </button>
          <div>
            <button id="btn-fav" aria-label="add to favorite">
              <svg area-hidden="true">
                <use href="#icon-favorite"></use>
              </svg>
              <svg area-hidden="true">
                <use href="#icon-favorite-filled"></use>
              </svg>
            </button>
            <button id="btn-share" aria-label="share product">
              <svg area-hidden="true">
                <use href="#icon-share"></use>
              </svg>
            </button>
          </div>
        </header>
        <div class="product-modal-images">
          <span class="spin"></span>
          <img class="visible" srcset="<%= data.product.main_image_id %>" decoding="async" sizes="max(500px, 60vw)" alt="product image">
        </div>
      </section>
      <section class="product-modal--block">
        <div class="product-modal-info">
          <h2><%= data.product.titulo %></h2>
          <div class="product-modal-info--stock">
            <div class="product-modal-type">
              <svg area-hidden="true">
                <use href="#icon-star-filled"></use>
              </svg>
              <span></span>
            </div>
            <span class="product-modal-stock">Stock <%= data.product.stock %></span>
          </div>
          <div class="product-modal-prices">
            <span class="price"><%= data.product.precio %></span>
            <s class="lastprice"><%= data.product.precio_anterior %></s>
          </div>
          <p class="product-modal-description"><%= data.product.info %></p>
        </div>
        <div class="product-modal-sizes">
          <label tabindex="0"><input type="radio" name="sizes">S</label>
          <label tabindex="0"><input type="radio" name="sizes">M</label>
          <label tabindex="0"><input type="radio" name="sizes">L</label>
          <label tabindex="0"><input type="radio" name="sizes">XL</label>
        </div>
        <div class="product-modal-picker">
          <button id="btn-menos">-</button>
          <input id="input-cantidad" type="number" value="1" min="1" max="99">
          <button id="btn-mas">+</button>
        </div>
        <aside class="product-modal-actions">
          <button id="btn-add">
            Agregar
            <svg area-hidden="true">
              <use href="#icon-cart-out"></use>
            </svg>
          </button>
          <button id="btn-buy">
            Whatsapp
            <svg area-hidden="true">
              <use href="#icon-cart-filled"></use>
            </svg>
          </button>
        </aside>
      </section>
    </section>
  </main>
  <div class="notify">
    <svg>
      <use href="#icon-notify"></use>
    </svg>
    <div class="notify-content">
      <p class="notify-title"></p>
      <span class="notify-text"></span>
    </div>
    <button class="notify-btn">✕</button>
  </div>

