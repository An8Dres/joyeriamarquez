<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= product.titulo %> $ <%= product.precio %> <%= product.info %>">
  <meta property="og:title" content="JOYERIA MARQUEZ">
  <meta property="og:description" content="<%= product.titulo %> $<%= product.precio %> <%= product.info %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:url" content="https://an8dres.github.io/joyeriamarquez/">
  <meta property="og:type" content="website">
  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta property="twitter:domain" content="an8dres.github.io">
  <meta property="twitter:url" content="https://an8dres.github.io/joyeriamarquez/">
  <meta name="twitter:title" content="JOYERIA MARQUEZ">
  <meta name="twitter:description" content="<%= product.titulo %> $<%= product.precio %> <%= product.info %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/product.css">

  <link rel="preload" href="/fonts/Poppins-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/Cinzel-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin>
  
  <link rel="modulepreload" href="/js/ui/dom.js">
  <link rel="modulepreload" href="/js/main.js">
  <link rel="modulepreload" href="/js/services/api.js">
  <link rel="modulepreload" href="/js/services/router.js">
  <link rel="modulepreload" href="/js/features/product.js">

  <link rel="prefetch" href="/js/features/home.js" as="script">

  <link rel="icon" href="/favicon.ico">

  <script type="module" src="/js/main.js"></script>
  <title>Joyería Márquez</title>
</head>

<body>
  <main>
    <span class="progress-bar"></span>
    <aside class="aside">
      <div class="logo">
        <img src="/iconos/icon.avif" alt="Icon page">
        <h2>Joyería Márquez</h2>
      </div>
      <nav>
        <a href="/" data-action="nav">
          <svg area-hidden="true" class="icon">
            <use href="#icon-home"></use>
          </svg>
          <span>Inicio</span>
        </a>
        <a href="/search" data-action="nav">
          <svg area-hidden="true" class="icon">
            <use href="#icon-search"></use>
          </svg>
          <span>Buscar</span>
        </a>
        <!-- <a href="/orders" disabled>
          <svg area-hidden="true" class="icon">
            <use href="#icon-bag"></use>
          </svg>
          <span>Pedidos</span>
        </a> -->
        <a href="/favorites" data-action="nav">
          <svg area-hidden="true" class="icon">
            <use href="#icon-favorite"></use>
          </svg>
          <span>Favoritos</span>
        </a>
        <a href="/offers" id="offers" data-action="nav">
          <svg area-hidden="true" class="icon">
            <use href="#icon-off"></use>
          </svg>
          <span>Ofertas</span>
        </a>
        <a href="/profile" data-action="nav">
          <svg area-hidden="true" class="icon">
            <use href="#icon-profile"></use>
          </svg>
          <span>Perfil</span>
        </a>
        <span id="nav-selector"></span>
      </nav>
      <!-- <a href="https://wa.me/573243571105?text=Hola%20Joyer%C3%ADa%20M%C3%A1rquez" id="wsp" target="_blank">
          <svg area-hidden="true" class="icon">
            <use href="#icon-whatsapp"></use>
          </svg>
          Ir a Whatsapp
      </a> -->
    </aside>
    <section id="main-section">
      <header id="main-header">
        <div class="hdr-title">
          <h3>¡Bievenido!</h3>
          <p>¿Que deseas ver hoy?</p>
        </div>
        <div class="hdr-search">
          <input type="text" id="input-search" placeholder="Buscar, una pulsera de oro...">
          <svg>
            <use href="#icon-search"></use>
          </svg>
        </div>
        <div class="hdr-buttons">
          <a href="/notifications" id="btn-notify" aria-label="Notificaciones">
            <svg aria-hidden="true">
              <use href="#icon-notify"></use>
            </svg>
          </a>
          <a href="/cart" id="btn-cart" data-action="navigate" aria-label="Carrito de compras">
            <svg aria-hidden="true">
              <use href="#icon-cart"></use>
            </svg>
            <span class="counter">0</span>
          </a>
          <a href="/profile" id="btn-profile" aria-label="Perfil">A</a>
        </div>
      </header>
      <article id="product" class="page visible" data-click="back">
        <div class="product-container">
          <section>
            <header>
              <button data-action="back" class="btn-back" aria-label="go back">
                <svg area-hidden="true">
                  <use href="#icon-arrowback"></use>
                </svg>
              </button>
              <div>
                <button data-action="like" class="btn-like toggleable" aria-label="add to favorite">
                  <svg area-hidden="true">
                    <use href="#icon-favorite"></use>
                  </svg>
                  <svg area-hidden="true">
                    <use href="#icon-favorite-filled"></use>
                  </svg>
                </button>
                <button data-action="share" class="btn-share" aria-label="share product">
                  <svg area-hidden="true">
                    <use href="#icon-share"></use>
                  </svg>
                </button>
              </div>
            </header>
            <div class="product-images">
              <img srcset="<%= product.main_image_id %>" decoding="async" sizes="max(500px, 60vw)"
                alt="product image">
            </div>
          </section>
          <section>
            <h2><%= product.titulo %></h2>
            <div class="product-info">
              <span class="product-stock">Stock <%= product.stock %></span>
              <span class="product-type"><%= product.tipo %></span>
            </div>
            <div class="product-prices">
              <div>
                <p>Ahora</p>
                <span class="price">
                  <%= product.precio %> COP
                </span>
              </div>
              <div>
                <p>Antes</p>
                <s class="lastprice">
                  <%= product.precio_anterior %>
                </s>
              </div>
            </div>
            <div class="product-picker">
              <p>Cantidad</p>
              <div>
                <button data-action="decrement">-</button>
                <input type="number" value="1" min="1" max="99">
                <button data-action="increment">+</button>
              </div>
            </div>
            <aside class="product-actions">
              <button data-action="whatsapp" class="btn-buy">
                WHATSAPP
              </button>
              <button data-action="add" class="btn-add">
                AGREGAR
                <svg area-hidden="true">
                  <use href="#icon-cart-out"></use>
                </svg>
              </button>
            </aside>
            <div class="product-description">
              <p>Descripción</p>
              <p><%= product.info %></p>
            </div>
            <div class="phantom-box"></div>

          </section>
        </div>
      </article>
    </section>
  </main>

  <div class="notify">
    <svg>
      <use href="#icon-notify"></use>
    </svg>
    <div class="notify-content">
      <p class="notify-title"></p>
      <span class="notify-text"></span>
    </div>
    <button class="notify-btn" data-action="closeNotify">✕</button>
  </div>

