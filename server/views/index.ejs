  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Una web de productos de maquillaje y accesorios bastante económicos y accesibles para las mujeres.">
  <meta property="og:title" content="MILO BEAUTY STORE">
  <meta property="og:description" content="¡Aquí hay de todo! Skin-care, Maquillaje, Accesorios y mucho más con los mejores precios. 🥰">
