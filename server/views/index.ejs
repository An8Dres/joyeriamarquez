    <button class="menu-button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M160-680q-17 0-28.5-11.5T120-720q0-17 11.5-28.5T160-760h640q17 0 28.5 11.5T840-720q0 17-11.5 28.5T800-680H160Zm0 480q-17 0-28.5-11.5T120-240q0-17 11.5-28.5T160-280h640q17 0 28.5 11.5T840-240q0 17-11.5 28.5T800-200H160Zm0-240q-17 0-28.5-11.5T120-480q0-17 11.5-28.5T160-520h640q17 0 28.5 11.5T840-480q0 17-11.5 28.5T800-440H160Z"/></svg>
    </button>
    <header class="menu">
      <picture>
        <source srcset="src/logo/logo-120.avif" type="image/avif">
        <img id="logo" src="src/logo/logo-120.webp"
          alt="Un corazón celeste con una corona que dice Beauty Store by Milo y un labial a la izquierda">
      </picture>
      <nav>
        <a href="/" class="selected" tabindex="0">
          <svg area-hidden="true">
            <use href="#icon-products"></use>
          </svg>
          Productos
        </a>
        <a href="/makeup" tabindex="0">
          <svg area-hidden="true">
            <use href="#icon-makeup"></use>
          </svg>
          Maquillaje
        </a>
        <a href="/accessories" tabindex="0">
          <svg area-hidden="true">
            <use href="#icon-accessories"></use>
          </svg>
          Accesorios
        </a>
        <a href="/bag" id="btn-bag" tabindex="0">
          <svg area-hidden="true">
            <use href="#icon-bag"></use>
          </svg>
          Bolsa
          <span id="bag-counter" class="disabled"></span>
        </a>
        <a href="/account" id="btn-account" tabindex="0">
          <svg area-hidden="true"><use href="#icon-account"></use></svg>
          Cuenta
        </a>
        <span></span>
      </nav>
    </header>
    <section class="container">
      <div class="panel" tabindex="-1">
        <section class="products">
          <%- result %>
        </section>
      </div>
      <div class="notify">
        <svg><use href="#icon-notify"></use></svg>
        <div class="notify-content">
          <p class="notify-title"></p>
          <span class="notify-text"></span>
        </div>
      </div>
    </section>
  </main>
